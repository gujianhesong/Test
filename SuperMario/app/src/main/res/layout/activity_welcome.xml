<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_background">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:text="Super Mario"
        android:textSize="56sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="5"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="Android Adventure"
        android:textSize="28sp"
        android:textColor="#FFD700"
        android:textStyle="italic"/>

    <!-- Mario Character Placeholder (will be drawn) -->
    <ImageView
        android:id="@+id/marioImage"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerInParent="true"
        android:src="@drawable/ic_launcher_foreground"
        android:contentDescription="Mario"/>

    <!-- Start Button -->
    <Button
        android:id="@+id/startButton"
        android:layout_width="280dp"
        android:layout_height="65dp"
        android:layout_below="@id/marioImage"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:text="START GAME"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_background"
        android:elevation="8dp"/>

    <!-- Copyright -->
    <TextView
        android:id="@+id/copyrightText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="15dp"
        android:text="© 2024 Super Mario Game"
        android:textSize="14sp"
        android:textColor="#CCCCCC"/>

</RelativeLayout>
